{
  "manifest_version": 3,
  "name": "Simple Software Factory overlay",
  "version": "0.5.3",
  "description": "Live ssf agent state on github.com issue and pull request pages.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["pane-geometry.js", "pane-overlay.js", "writes-form.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "terminal.html",
        "terminal.js",
        "terminal.css",
        "factory-url.js",
        "pane-render.js",
        "pane-keys.js",
        "term-xterm.js",
        "term-wire.js",
        "vendor/xterm/xterm.mjs",
        "vendor/xterm/addon-fit.mjs",
        "vendor/xterm/xterm.css"
      ],
      "matches": ["https://github.com/*"],
      "use_dynamic_url": true
    }
  ],
  "action": {
    "default_title": "ssf factories"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
