post_install() {
  echo "==> ssf installed. Run 'ssf setup' as the user who will run the factory."
}
post_upgrade() {
  local user exec_start
  for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
    [ "$(systemctl --machine="${user}@.host" --user show -p FragmentPath --value ssf.service 2>/dev/null)" = /usr/lib/systemd/user/ssf.service ] || continue
    exec_start=$(systemctl --machine="${user}@.host" --user show -p ExecStart --value ssf.service 2>/dev/null) || continue
    [ "$(printf '%s' "$exec_start" | grep -o 'path=' | wc -l)" -eq 1 ] || continue
    printf '%s' "$exec_start" | grep -F 'path=/usr/bin/ssf ;' >/dev/null || continue
    printf '%s' "$exec_start" | grep -F 'argv[]=/usr/bin/ssf run ;' >/dev/null || continue
    systemctl --machine="${user}@.host" --user is-active --quiet ssf.service >/dev/null 2>&1 || continue
    systemctl --machine="${user}@.host" --user try-restart ssf.service || echo "==> warning: could not restart ssf.service for $user" >&2
  done
}
post_remove() {
  echo "==> ssf removed; user configuration, state, projects, VM data, and the Omarchy widget were preserved."
}
