post_install() {
  echo "==> ssf installed. Run 'ssf setup' as the user who will run the factory."
}
post_upgrade() {
  local user unit units fragment exec_start target target_files target_units targets
  for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
    target_files=$(systemctl --machine="${user}@.host" --user list-unit-files --no-legend --plain 'ssf@*.service' 2>/dev/null) || target_files=
    target_units=$(systemctl --machine="${user}@.host" --user list-units --all --no-legend --plain 'ssf@*.service' 2>/dev/null) || target_units=
    targets=$(printf '%s\n%s\n' "$target_files" "$target_units" | awk '$1 ~ /^ssf@[^[:space:]]+\.service$/ {print $1}' | sort -u)
    units="ssf.service $targets"
    systemctl --machine="${user}@.host" --user daemon-reload || { echo "==> warning: could not reload ssf services for $user" >&2; continue; }
    for unit in $units; do
      fragment=$(systemctl --machine="${user}@.host" --user show -p FragmentPath --value "$unit" 2>/dev/null) || continue
      case "$unit:$fragment" in
        ssf.service:/usr/lib/systemd/user/ssf.service|ssf@*.service:/usr/lib/systemd/user/ssf@.service) ;;
        *) continue ;;
      esac
      exec_start=$(systemctl --machine="${user}@.host" --user show -p ExecStart --value "$unit" 2>/dev/null) || continue
      [ "$(printf '%s' "$exec_start" | grep -o 'path=' | wc -l)" -eq 1 ] || continue
      target=${unit#ssf@}; target=${target%.service}
      if [ "$unit" != ssf.service ] &&
         printf '%s' "$exec_start" | grep -F "path=/usr/bin/ssf-server ;" >/dev/null &&
         printf '%s' "$exec_start" | grep -F "argv[]=/usr/bin/ssf-server --target $target ;" >/dev/null; then :
      elif [ "$unit" = ssf.service ] &&
           printf '%s' "$exec_start" | grep -F 'path=/usr/bin/ssf-server ;' >/dev/null &&
           printf '%s' "$exec_start" | grep -F 'argv[]=/usr/bin/ssf-server ;' >/dev/null; then :
      elif [ "$unit" = ssf.service ] &&
           printf '%s' "$exec_start" | grep -F 'path=/usr/bin/ssf ;' >/dev/null &&
           printf '%s' "$exec_start" | grep -F 'argv[]=/usr/bin/ssf run ;' >/dev/null; then :
      else continue
      fi
      systemctl --machine="${user}@.host" --user is-active --quiet "$unit" >/dev/null 2>&1 || continue
      systemctl --machine="${user}@.host" --user try-restart "$unit" || echo "==> warning: could not restart $unit for $user" >&2
    done
  done
}
post_remove() {
  echo "==> ssf removed; user configuration, state, projects, VM data, and the Omarchy widget were preserved."
}
