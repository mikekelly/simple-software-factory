post_install() {
  echo "==> ssf installed. Run 'ssf setup' as the user who will run the factory."
}
post_upgrade() {
  # Restart running services on the new version; never a VM or agent (docs/operate.md).
  /usr/lib/ssf/package-post-upgrade
}
post_remove() {
  echo "==> ssf removed; user configuration, state, projects and VM data were preserved."
}
