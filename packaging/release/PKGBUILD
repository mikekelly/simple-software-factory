# Maintainer: Mike Kelly <mikekelly321@gmail.com>
#
# Release PKGBUILD: builds ssf from the immutable GitHub archive pinned below.
# This directory (PKGBUILD, ssf.install, .omarchy/package.json) is what goes
# into Omarchy's package repository as pkgbuilds/ssf/. The development build
# of the working tree is ../PKGBUILD, which sources this file for everything
# but the source and version.
#
# New release: first freeze and push the implementation commit (Cargo.toml
# version included), then pin this recipe to that commit's GitHub archive,
# update pkgver/pkgrel and sha256sums, and build with makepkg -fd. Tag the
# recipe commit only after the ordinary checksum-verified build succeeds.

pkgname=ssf
pkgver=0.4.0
pkgrel=1
pkgdesc="GitHub issues assigned to a bot become coding-agent sessions in herdr or Orca"
arch=('x86_64' 'aarch64')
url="https://github.com/mikekelly/simple-software-factory"
license=('MIT')
# openssh: `ssf auth login` makes the bot's key with ssh-keygen and the bot pushes over ssh.
depends=('gcc-libs' 'glibc' 'jq' 'systemd' 'github-cli' 'herdr' 'openssh' 'xdg-utils')
makedepends=('cargo')
checkdepends=('git')
optdepends=(
  'orca-ide-bin: Orca desktop app and CLI, the alternative driver (driver = "orca"; not in the Omarchy repo, install it by hand)'
  'omarchy: bar widget, menu entries and floating-terminal flows'
  'gum: nicer prompts in ssf-ui'
  'fakeroot: builds the microVM image (ssf vm build)'
  'libarchive: bsdtar, unpacks the Ubuntu root tarball for the microVM image'
  'e2fsprogs: mkfs.ext4, makes the microVM disks'
  'curl: downloads Firecracker, gvproxy, the guest kernel and Ubuntu root'
)
install=ssf.install
# !debug: no ssf-debug split package. !lto: makepkg's -flto would reach
# ring's C objects through the cc crate; cargo's release profile decides.
options=('!debug' '!lto')
_source_commit=5d3311f665d35bb763b0b8f584f35f206b7ae5ca
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_source_commit.tar.gz")
sha256sums=('0399b3b56dd0207bd70a8a5c538e9c1eddb5fd25b267e9208b5dbb6858a114e2')

# GitHub names the unpacked tree after the repository, not the package.
_srcname="simple-software-factory-$_source_commit"

prepare() {
  cd "$_srcname"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcname"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_srcname"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$_srcname"
  install -Dm755 target/release/ssf "$pkgdir/usr/bin/ssf"
  install -Dm755 target/release/ssf-server "$pkgdir/usr/bin/ssf-server"
  install -Dm755 bin/ssf-ui "$pkgdir/usr/bin/ssf-ui"
  install -Dm644 packaging/ssf.service "$pkgdir/usr/lib/systemd/user/ssf.service"
  install -Dm755 packaging/package-pre-remove.sh "$pkgdir/usr/lib/ssf/package-pre-remove"
  install -Dm644 packaging/ssf-pre-remove.hook "$pkgdir/usr/share/libalpm/hooks/ssf-pre-remove.hook"
  install -Dm644 manifest.json "$pkgdir/usr/share/ssf/omarchy-plugin/manifest.json"
  install -Dm644 marketplace/FactoryPanel.qml "$pkgdir/usr/share/ssf/omarchy-plugin/marketplace/FactoryPanel.qml"
  install -Dm644 config.example.toml "$pkgdir/usr/share/ssf/config.example.toml"
  # The whole vm/ tree, mirrored under /usr/share/ssf: make-base.sh, the
  # guest scripts, the units and their per-backend drop-ins. A loop, not a
  # list, because `ssf vm build` reads whatever the guest scripts ask for
  # and a file missed here breaks it on every packaged host. Modes come
  # from the tree: scripts 755, units and sudoers 644.
  while IFS= read -r -d '' f; do
    if [ -x "$f" ]; then _m=755; else _m=644; fi
    install -Dm$_m "$f" "$pkgdir/usr/share/ssf/$f"
  done < <(find vm -type f -print0)
  install -Dm644 SSF.example.md "$pkgdir/usr/share/ssf/SSF.example.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/ssf/README.md"
  install -d "$pkgdir/usr/share/doc/ssf/docs"
  install -m644 docs/*.md "$pkgdir/usr/share/doc/ssf/docs/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/ssf/LICENSE"
}
