# Maintainer: Mike Kelly <mikekelly321@gmail.com>
#
# Development build of the working tree this file lives in (../), local
# changes included. From the repository root:
#     cd packaging && makepkg -si
# Everything but the source and the version comes from release/PKGBUILD, the
# tagged-release build that Omarchy's package repository uses; keep package()
# and the metadata there.

_repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$_repo/packaging/release/PKGBUILD"

pkgver=0.1.0.r456.g75eadfd
pkgrel=1
source=()
sha256sums=()
_srcname="$pkgname"

pkgver() {
  local base
  base=$(grep -m1 '^version' "$_repo/Cargo.toml" | sed 's/.*"\(.*\)"/\1/')
  if git -C "$_repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf '%s.r%s.g%s' "$base" "$(git -C "$_repo" rev-list --count HEAD)" "$(git -C "$_repo" rev-parse --short HEAD)"
  else
    printf '%s' "$base"
  fi
}

prepare() {
  # Copy the working tree (not just HEAD) so local changes are what gets built.
  rm -rf "$srcdir/$_srcname"
  mkdir -p "$srcdir/$_srcname"
  tar -C "$_repo" --exclude=./target --exclude=./packaging/src --exclude=./packaging/pkg \
      --exclude='./packaging/*.pkg.tar.*' --exclude=./packaging/release/src --exclude=./packaging/release/pkg \
      --exclude='./packaging/release/*.pkg.tar.*' --exclude='./packaging/release/*.tar.gz' \
      --exclude=./.git -cf - . | tar -C "$srcdir/$_srcname" -xf -
  cd "$srcdir/$_srcname"
  # Build artifacts outlive the copy (a rebuild is incremental), and the
  # release package() finds them at target/ inside the tree.
  mkdir -p "$srcdir/target"
  ln -s "$srcdir/target" target
  export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$_srcname"
  export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
  cargo build --frozen --release
}

check() {
  cd "$srcdir/$_srcname"
  export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
  cargo test --frozen --release
}
