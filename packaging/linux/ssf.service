# ssf.service for Debian, Ubuntu and Fedora. Explicit `ssf setup` enables
# this default.target unit and login linger for one user.

[Unit]
Description=Simple Software Factory: GitHub issues assigned to the bot become agent workspaces in herdr
Documentation=https://github.com/mikekelly/simple-software-factory

[Service]
Type=simple
ExecStart=/usr/bin/ssf-server
# With `[vm] enabled`, `ssf-server` starts a Firecracker VM in a session of its
# own and shuts it down cleanly on SIGTERM; only the main process gets the
# signal, the VM is told by ssf.
KillMode=mixed
TimeoutStopSec=90
# Any exit, a clean one included: systemd counts SIGTERM as success, so
# `on-failure` would leave the factory down after an unexplained one (#344).
# An explicit `systemctl stop` is not undone by this.
Restart=always
RestartSec=15
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
