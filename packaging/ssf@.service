[Unit]
Description=Simple Software Factory server %i
Documentation=https://github.com/mikekelly/simple-software-factory

[Service]
Type=simple
ExecStart=/usr/bin/ssf-server --target %i
# With a VM target, `ssf-server` only supervises the VM. Firecracker and
# gvproxy (or lima's host agent) run in systemd scopes of their own
# (ssf-vm-<name>-*.scope), so stopping or restarting this service, as a
# package upgrade does, leaves the guest running and a new `ssf-server`
# reattaches to it. `ssf ui service disable` stops both, and so does package
# removal.
KillMode=mixed
TimeoutStopSec=90
# Any exit, a clean one included: systemd counts SIGTERM as success, so
# `on-failure` would leave the factory down after an unexplained one (#344).
# An explicit `systemctl stop` is not undone by this.
Restart=always
RestartSec=15
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
