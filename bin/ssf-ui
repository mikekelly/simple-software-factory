#!/bin/bash
# Desktop glue for Simple Software Factory's Omarchy **Factory** menu: the
# service toggle, the log, and a status-and-doctor terminal. It shows and
# reaches state; it does not set anything up. Setup (signing the bot in,
# watching repositories) is `ssf auth` and `ssf repo` from a terminal,
# following docs/setup.md.
#
# The bar widget this package used to ship had two actions of its own here, a
# session list and opening a session's workspace; the widget is gone (#413)
# and so are they. `ssf peers`, `ssf dashboard` and `ssf vm attach` are the
# commands for what they did.

set -euo pipefail

usage() {
  cat <<USAGE
Usage: ssf-ui <command>

  service <enable|disable|toggle|restart|is-enabled>
  logs                  Follow the service log in a terminal
  status                Show status, then the doctor report

Setup is not here: \`ssf auth login\` signs the bot in, \`ssf repo add\` watches
a repository (docs/setup.md walks through it).
USAGE
}

notify() {
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send "$@" || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "Software Factory" "$*" || true
  fi
}

cmd_service() {
  case "${1:-}" in
    enable|disable|toggle|is-enabled) ssf ui service "$1" ;;
    restart)
      systemctl --user restart ssf.service && notify "Software Factory restarted"
      ;;
    *) usage; exit 1 ;;
  esac
}

cmd_logs() {
  if command -v omarchy-launch-floating-terminal-with-presentation >/dev/null 2>&1 && [[ ! -t 1 ]]; then
    exec omarchy-launch-terminal journalctl --user -fu ssf.service -n 200
  fi
  exec journalctl --user -fu ssf.service -n 200
}

cmd_status() {
  ssf status || true
  echo
  ssf doctor || true
  echo
  if command -v gum >/dev/null 2>&1; then
    gum confirm "Follow the log?" && journalctl --user -fu ssf.service -n 50
  fi
}

case "${1:-}" in
  service) shift; cmd_service "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  status) shift; cmd_status "$@" ;;
  -h|--help|help|"") usage ;;
  *) echo "ssf-ui: unknown command $1" >&2; usage; exit 1 ;;
esac
