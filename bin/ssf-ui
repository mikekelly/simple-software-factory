#!/bin/bash
# Desktop glue for Simple Software Factory's bar widget and Omarchy menu: the
# service toggle, the log, a status-and-doctor terminal, the session list, and
# opening a session's workspace. It shows and reaches state; it does not set
# anything up. Setup (signing the bot in, watching repositories) is `ssf auth`
# and `ssf repo` from a terminal, following docs/setup.md.

set -euo pipefail

usage() {
  cat <<USAGE
Usage: ssf-ui <command>

  service <enable|disable|toggle|restart|is-enabled>
  logs                  Follow the service log in a terminal
  status                Show status, then the doctor report
  peers                 Show the agent sessions and what each is doing
  open-workspace <worktree-id> [issue-url]

Setup is not here: \`ssf auth login\` signs the bot in, \`ssf repo add\` watches
a repository (docs/setup.md walks through it).
USAGE
}

notify() {
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send "$@" || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "Software Factory" "$*" || true
  fi
}

cmd_service() {
  case "${1:-}" in
    enable|disable|toggle|is-enabled) ssf ui service "$1" ;;
    restart)
      systemctl --user restart ssf.service && notify "Software Factory restarted"
      ;;
    *) usage; exit 1 ;;
  esac
}

cmd_logs() {
  if command -v omarchy-launch-floating-terminal-with-presentation >/dev/null 2>&1 && [[ ! -t 1 ]]; then
    exec omarchy-launch-terminal journalctl --user -fu ssf.service -n 200
  fi
  exec journalctl --user -fu ssf.service -n 200
}

cmd_status() {
  ssf status || true
  echo
  ssf doctor || true
  echo
  if command -v gum >/dev/null 2>&1; then
    gum confirm "Follow the log?" && journalctl --user -fu ssf.service -n 50
  fi
}

cmd_peers() {
  if command -v omarchy-launch-floating-terminal-with-presentation >/dev/null 2>&1 && [[ -z ${SSF_UI_PRESENTED:-} && ! -t 0 ]]; then
    SSF_UI_PRESENTED=1 exec omarchy-launch-floating-terminal-with-presentation ssf-ui peers
  fi
  ssf peers --all || true
  if [[ -t 0 ]]; then
    echo
    read -rsn1 -p "Press any key to close"
  fi
}

cmd_open_workspace() {
  local id="${1:-}" url="${2:-}"
  local orca="${ORCA_CLI_COMMAND:-/usr/lib/orca-ide/bin/orca-ide}"
  # The factory in a VM: the workspace is in the guest's herdr; attach to it.
  if [[ -n $id ]] && ssf vm status --json 2>/dev/null | jq -e '.enabled and (.running != false)' >/dev/null 2>&1; then
    if command -v omarchy-launch-terminal >/dev/null 2>&1; then
      omarchy-launch-terminal ssf vm attach
    else
      "${TERMINAL:-alacritty}" -e ssf vm attach
    fi
    return
  fi
  # Workspace ids tell the driver apart: Orca's carry `::`, herdr's are `w<N>@<path>`.
  if [[ -n $id && $id == *::* && -x $orca ]] && "$orca" worktree show --worktree "id:$id" --json >/dev/null 2>&1; then
    "$orca" worktree set --worktree "id:$id" --json >/dev/null 2>&1 || true
    "$orca" terminal switch --worktree "id:$id" --json >/dev/null 2>&1 || true
    omarchy-launch-or-focus orca-ide 2>/dev/null || true
    return
  fi
  if [[ -n $id && $id == w*@* ]] && command -v "${HERDR_COMMAND:-herdr}" >/dev/null 2>&1; then
    if "${HERDR_COMMAND:-herdr}" workspace focus "${id%%@*}" >/dev/null 2>&1; then
      return
    fi
  fi
  if [[ -n $url ]]; then
    omarchy-launch-browser "$url" 2>/dev/null || xdg-open "$url"
  fi
}

case "${1:-}" in
  service) shift; cmd_service "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  status) shift; cmd_status "$@" ;;
  peers) shift; cmd_peers "$@" ;;
  open-workspace) shift; cmd_open_workspace "$@" ;;
  -h|--help|help|"") usage ;;
  *) echo "ssf-ui: unknown command $1" >&2; usage; exit 1 ;;
esac
