#!/bin/sh
set -eu

harness=$1
shift
case "$harness" in
  omp|pi|opencode) ;;
  *) echo "ssf-pi-launch: unsupported harness: $harness" >&2; exit 2 ;;
esac

# The delivery bridge chooses its injection mode by harness: OMP's extension API
# has a non-interrupting step-boundary channel, Pi's does not. A by-hand launcher
# run inside a session's pane inherits that session's model and effort, which are
# not this one's: drop them unless the harness is the one the environment names.
[ "${SSF_HARNESS:-}" = "$harness" ] || unset SSF_MODEL SSF_EFFORT
SSF_HARNESS=$harness
export SSF_HARNESS

session_dir=${SSF_DELIVERY_MAILBOX:?SSF_DELIVERY_MAILBOX is not set}/session
mkdir -p "$session_dir"

if [ "$harness" = opencode ]; then
  # OpenCode keeps its sessions in its own database; the bridge plugin names
  # the one this mailbox's conversation is in.
  bridge=${SSF_OPENCODE_BRIDGE:?SSF_OPENCODE_BRIDGE is not set}
  id=$(cat "$session_dir/opencode-session" 2>/dev/null || true)
  case "$id" in
    ses_*[!A-Za-z0-9_]*|'') ;;
    ses_*)
      # A session deleted since is started afresh rather than refused.
      known=$(opencode session list --pure --format json </dev/null 2>/dev/null || true)
      case "$known" in
        *"\"$id\""*) set -- "$@" --session "$id" ;;
      esac
      ;;
  esac
  # The plugin serves the mailbox only in this process (exec keeps the pid):
  # an `opencode` the agent runs inherits the config but not the mailbox.
  # A configuration already in OPENCODE_CONFIG_CONTENT is kept: the plugin is
  # added to its `plugin` list. Perl's core JSON::PP does the merge (perl is a
  # dependency of the git every factory host has); a merge it cannot do stops
  # the launch rather than dropping the user's configuration.
  # Without one, no merge is needed and perl is not required.
  if [ -z "${OPENCODE_CONFIG_CONTENT:-}" ]; then
    OPENCODE_CONFIG_CONTENT=$(printf '{"plugin":["file://%s"]}' "$bridge")
  else
  OPENCODE_CONFIG_CONTENT=$(SSF_PLUGIN="file://$bridge" perl -MJSON::PP -e '
    my $json = JSON::PP->new->canonical;
    my $given = $ENV{OPENCODE_CONFIG_CONTENT} // "";
    my $config = $given =~ /\S/ ? $json->decode($given) : {};
    die "not a JSON object\n" unless ref $config eq "HASH";
    my $list = $config->{plugin} //= [];
    die "its plugin entry is not a list\n" unless ref $list eq "ARRAY";
    push @$list, $ENV{SSF_PLUGIN}
      unless grep { !ref && $_ eq $ENV{SSF_PLUGIN} } @$list;
    print $json->encode($config);
  ') || {
    echo "ssf-pi-launch: cannot add the ssf delivery plugin to OPENCODE_CONFIG_CONTENT; fix or unset it" >&2
    exit 2
  }
  fi
  SSF_OPENCODE_PID=$$
  export OPENCODE_CONFIG_CONTENT SSF_OPENCODE_PID
  exec opencode "$@"
fi

latest=$(find "$session_dir" -maxdepth 1 -type f -name '*.jsonl' -print | sort | tail -n 1)

if [ -n "$latest" ]; then
  if [ "$harness" = omp ]; then
    set -- "$@" --resume "$latest"
  else
    set -- "$@" --session "$latest"
  fi
else
  set -- "$@" --session-dir "$session_dir"
fi

exec "$harness" "$@"
