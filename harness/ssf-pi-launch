#!/bin/sh
set -eu

harness=$1
shift
case "$harness" in
  omp|pi) ;;
  *) echo "ssf-pi-launch: unsupported harness: $harness" >&2; exit 2 ;;
esac

# The delivery bridge chooses its injection mode by harness: OMP's extension API
# has a non-interrupting step-boundary channel, Pi's does not. A by-hand launcher
# run inside a session's pane inherits that session's model and effort, which are
# not this one's: drop them unless the harness is the one the environment names.
[ "${SSF_HARNESS:-}" = "$harness" ] || unset SSF_MODEL SSF_EFFORT
SSF_HARNESS=$harness
export SSF_HARNESS

session_dir=${SSF_DELIVERY_MAILBOX:?SSF_DELIVERY_MAILBOX is not set}/session
mkdir -p "$session_dir"
latest=$(find "$session_dir" -maxdepth 1 -type f -name '*.jsonl' -print | sort | tail -n 1)

if [ -n "$latest" ]; then
  if [ "$harness" = omp ]; then
    set -- "$@" --resume "$latest"
  else
    set -- "$@" --session "$latest"
  fi
else
  set -- "$@" --session-dir "$session_dir"
fi

exec "$harness" "$@"
