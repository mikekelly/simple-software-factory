# The ssf user may restart its own services, read the journal and shut the
# guest down, so `ssf vm sync`, `ssf vm logs` and `ssf vm stop` work over
# ssh without a root login. Nothing else.
Cmnd_Alias SSF_UNITS = /usr/bin/systemctl restart ssf, /usr/bin/systemctl restart ssf.service, \
    /usr/bin/systemctl restart herdr-server, /usr/bin/systemctl restart herdr-server.service, \
    /usr/bin/systemctl stop ssf, /usr/bin/systemctl stop ssf.service, \
    /usr/bin/systemctl start ssf, /usr/bin/systemctl start ssf.service, \
    /usr/bin/systemctl status *, /usr/bin/journalctl *, \
    /usr/bin/systemctl poweroff, /usr/bin/systemctl reboot
ssf ALL=(root) NOPASSWD: SSF_UNITS
