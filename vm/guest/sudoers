# The ssf user is root through sudo, no password: the VM is the isolation
# boundary, and the agent runs its own machine (installs packages, manages
# the units, reboots). Sessions still run as ssf, not root, because Claude
# Code refuses its permission-free mode as root. `ssf vm sync`, `ssf vm
# logs` and `ssf vm stop` use the same rule over ssh.
ssf ALL=(ALL) NOPASSWD: ALL
