[Unit]
Description=Mount the data disk and take the host's ssf binary, config and keys from the seed (disk or share)
DefaultDependencies=no
After=local-fs.target
Before=sshd.service ssh.service herdr-server.service ssf.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/ssf/seed.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
