[Unit]
Description=Simple Software Factory daemon (inside the VM)
After=ssf-seed.service ssf-net.service herdr-server.service
Requires=ssf-seed.service
Wants=network-online.target

[Service]
User=ssf
Group=ssf
Environment=HOME=/home/ssf
Environment=SSF_VM_GUEST=1
Environment=SSF_STATE_DIR=/var/lib/ssf/state
Environment=HERDR_COMMAND=/usr/local/bin/herdr
Environment=RUST_LOG=info
Environment=LANG=en_US.UTF-8
WorkingDirectory=/home/ssf
ExecStart=/usr/local/bin/ssf-server
# Any exit, a clean one included: systemd counts SIGTERM as success, so
# `on-failure` would leave the factory down after an unexplained one (#344).
# An explicit `systemctl stop` is not undone by this.
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
